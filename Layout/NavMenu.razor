<div class="top-row navbar navbar-dark py-2">
    <div class="container-fluid justify-content-center position-relative">
        <a class="navbar-brand brand-centered d-flex flex-column align-items-center gap-1 text-center m-0" href="">
            <img src="img/logo.svg" alt="Логотип Честный Знак" width="34" height="34" />
            <span>XML&nbsp;для&nbsp;Честный&nbsp;Знак</span>
        </a>
        <button title="Меню навигации" class="navbar-toggler position-absolute end-0 me-2" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
