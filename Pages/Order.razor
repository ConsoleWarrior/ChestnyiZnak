@page "/order"
@inject OrderTemplateService OrderTemplate
@inject OrderParserService OrderParser
@inject OrderXmlService OrderXml
@inject XsdValidationService XsdValidation
@inject IJSRuntime JS

<PageTitle>Заказ кодов маркировки — генератор XML | Честный Знак</PageTitle>

<div class="container py-4">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Генератор заказа кодов маркировки</h1>
        <p class="lead text-muted">
            Соберите XML-заказ кодов DataMatrix для товаров (кроме молочной продукции) по списку GTIN.
            Готовый файл загружайте в станцию управления заказами (СУЗ).
        </p>
        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle p-2">
            🔒 Всё считается в браузере, данные никуда не отправляются
        </span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <!-- ШАГ 1 -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="badge bg-success rounded-circle me-2">1</span>
                        Скачайте шаблон Excel
                    </h5>
                    <p class="card-text text-muted">
                        Две колонки: <b>GTIN</b> (14 цифр) и <b>Количество</b> кодов.
                        GTIN в текстовом формате — ведущие нули сохранятся.
                        <b>Не более 10 строк (GTIN)</b> в одном заказе.
                    </p>
                    <button class="btn btn-success btn-lg" @onclick="DownloadTemplateAsync" disabled="@isGenerating">
                        @if (isGenerating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Формируем файл…</span>
                        }
                        else
                        {
                            <span>⬇️ Скачать образец Excel</span>
                        }
                    </button>
                </div>
            </div>

            <!-- ШАГ 2 -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="badge bg-success rounded-circle me-2">2</span>
                        Загрузите заполненный файл
                    </h5>
                    <InputFile class="form-control" accept=".xlsx" OnChange="OnFileSelectedAsync" disabled="@isParsing" />

                    @if (isParsing)
                    {
                        <div class="mt-3 text-muted">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Читаем файл…
                        </div>
                    }

                    @if (parseResult is not null && !isParsing)
                    {
                        @if (parseResult.FileErrors.Count > 0)
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                @foreach (var err in parseResult.FileErrors)
                                {
                                    <div>⛔ @err</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mt-3">
                                <div class="d-flex gap-2 mb-2">
                                    <span class="badge bg-success">Корректных строк: @parseResult.ValidCount</span>
                                    @if (parseResult.InvalidCount > 0)
                                    {
                                        <span class="badge bg-danger">С ошибками: @parseResult.InvalidCount</span>
                                    }
                                </div>

                                <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                                    <table class="table table-sm table-bordered align-middle small mb-0">
                                        <thead class="table-light position-sticky top-0">
                                            <tr>
                                                <th style="width: 40px;">#</th>
                                                <th>GTIN</th>
                                                <th style="width: 120px;">Количество</th>
                                                <th style="width: 90px;">Статус</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in parseResult.Rows)
                                            {
                                                <tr class="@(row.IsValid ? "" : "table-danger")">
                                                    <td class="text-muted">@row.RowNumber</td>
                                                    <td class="font-monospace">@row.Gtin</td>
                                                    <td>@row.QuantityRaw</td>
                                                    <td>
                                                        @if (row.IsValid)
                                                        {
                                                            <span class="text-success">✓ ОК</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-danger">✗ @row.Errors.Count</span>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (!row.IsValid)
                                                {
                                                    <tr class="table-danger">
                                                        <td></td>
                                                        <td colspan="3" class="text-danger small">@string.Join("; ", row.Errors)</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- ШАГ 3 -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="badge bg-success rounded-circle me-2">3</span>
                        Параметры заказа и скачивание XML
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Контактное лицо (ФИО или e-mail)</label>
                            <input class="form-control" @bind="contactPerson" placeholder="Иванов И.И." />
                            <div class="form-text">С кем связаться по этому заказу.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Способ выпуска</label>
                            <select class="form-select" @bind="releaseMethodCode">
                                @foreach (var kv in OrderXmlService.ReleaseMethods)
                                {
                                    <option value="@kv.Value">@kv.Key</option>
                                }
                            </select>
                            <div class="form-text">Почему заказываете коды: остатки на складе, импорт или замена испорченного кода.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Способ создания</label>
                            <select class="form-select" @bind="createMethodCode">
                                @foreach (var kv in OrderXmlService.CreateMethods)
                                {
                                    <option value="@kv.Value">@kv.Key</option>
                                }
                            </select>
                            <div class="form-text">Кто печатает коды: вы сами или оператор ЦРПТ.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Генерация серийных номеров</label>
                            <select class="form-select" @bind="serialNumberTypeCode">
                                @foreach (var kv in OrderXmlService.SerialNumberTypes)
                                {
                                    <option value="@kv.Value">@kv.Key</option>
                                }
                            </select>
                            <div class="form-text">Кто задаёт уникальную часть кода. Обычно — оператор (ЦРПТ).</div>
                        </div>
                    </div>

                    <!-- Официальная XSD заказа (только из ЛК) -->
                    <div class="alert alert-warning small">
                        ⚠️ Официальной XSD-схемы заказа у нас нет — она доступна только в вашем личном кабинете
                        (СУЗ / раздел «Помощь»). Чтобы не отдать вам файл, который СУЗ отклонит, заказ формируется
                        <b>только после того, как вы приложите официальную XSD</b> — и сразу проверяется по ней.
                        Набор «способов выпуска» ниже взят из неофициального источника и может быть неполным
                        (например, для обычного производства РФ значение появится после сверки с вашей XSD).
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Официальная XSD заказа (из ЛК)</label>
                            <InputFile class="form-control" accept=".xsd" OnChange="OnOrderXsdSelected" />
                            @if (orderXsdName is not null)
                            {
                                <div class="form-text text-success">✓ @orderXsdName</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Доп. файл схемы <span class="text-muted">(если основная на него ссылается, иначе пропустите)</span></label>
                            <InputFile class="form-control" accept=".xsd" OnChange="OnOrderIncludeSelected" />
                            @if (orderIncludeName is not null)
                            {
                                <div class="form-text text-success">✓ @orderIncludeName</div>
                            }
                        </div>
                    </div>

                    @{
                        var validCount = parseResult?.ValidCount ?? 0;
                        var positions = parseResult?.Rows.Count ?? 0;
                        var tooManyPositions = positions > MaxOrderPositions;
                        var canGenerate = validCount > 0 && !tooManyPositions
                            && !string.IsNullOrWhiteSpace(contactPerson)
                            && orderXsdBytes is not null;
                    }

                    <button class="btn btn-success btn-lg" @onclick="GenerateAndDownloadAsync" disabled="@(!canGenerate || isGeneratingXml)">
                        @if (isGeneratingXml)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Проверяем и формируем…</span>
                        }
                        else
                        {
                            <span>⬇️ Проверить по XSD и скачать</span>
                        }
                    </button>

                    @if (tooManyPositions)
                    {
                        <div class="alert alert-danger mt-2 mb-0 small">
                            В одном заказе максимум @MaxOrderPositions товарных позиций (GTIN). Сейчас @positions — разбейте на несколько файлов.
                        </div>
                    }
                    else if (validCount == 0)
                    {
                        <div class="form-text">Кнопка станет активной после загрузки файла с корректными строками (Шаг 2).</div>
                    }
                    else if (string.IsNullOrWhiteSpace(contactPerson))
                    {
                        <div class="form-text text-warning-emphasis">Укажите контактное лицо.</div>
                    }
                    else if (orderXsdBytes is null)
                    {
                        <div class="form-text text-warning-emphasis">Приложите официальную XSD-схему заказа из ЛК.</div>
                    }

                    @if (validationResult is not null && !validationResult.IsValid)
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <div class="fw-bold mb-1">❌ XML не прошёл проверку по вашей схеме — файл не скачан:</div>
                            <ul class="mb-1 small">
                                @foreach (var m in validationResult.Messages)
                                {
                                    <li>@m</li>
                                }
                            </ul>
                            <div class="small text-muted">
                                Скорее всего, наша структура заказа расходится с официальной. Пришлите мне эту XSD —
                                подгоню генератор под неё.
                            </div>
                        </div>
                    }
                    else if (validationResult is not null && validationResult.IsValid)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            ✅ XML соответствует вашей схеме — файл скачан.
                        </div>
                    }

                    @if (xmlDownloaded)
                    {
                        <FeedbackBanner />
                    }
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-title">Что это за документ</h6>
                    <p class="small text-muted mb-0">
                        «Заказ кодов» — это запрос в систему на <b>генерацию новых кодов</b> DataMatrix
                        по вашим GTIN. Уже имеющиеся коды сюда не вносятся —
                        для них используйте раздел «Ввод в оборот».
                    </p>
                </div>
            </div>

            <div class="border rounded d-flex align-items-center justify-content-center text-muted small bg-light"
                 style="min-height: 250px;">
                Рекламный блок РСЯ
            </div>
        </div>

    </div>
</div>

@code {
    private bool isGenerating;
    private bool isGeneratingXml;
    private bool isParsing;
    private bool xmlDownloaded;
    private OrderParseResult? parseResult;

    // Лимит ГИС МТ: максимум 10 товарных позиций (GTIN) в одном файле заказа.
    private const int MaxOrderPositions = 10;

    // Параметры заказа со значениями по умолчанию.
    private string contactPerson = "";
    private string releaseMethodCode = "REMAINS";
    private string createMethodCode = "SELF_MADE";
    private string serialNumberTypeCode = "OPERATOR";

    // Официальная XSD заказа (из ЛК) — без неё не формируем.
    private byte[]? orderXsdBytes;
    private byte[]? orderIncludeBytes;
    private string? orderXsdName;
    private string? orderIncludeName;
    private XsdValidationService.Result? validationResult;

    private const long MaxFileSize = 10 * 1024 * 1024;
    private const long MaxXsdSize = 5 * 1024 * 1024;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        isParsing = true;
        parseResult = null;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(MaxFileSize).CopyToAsync(ms);
            ms.Position = 0;
            parseResult = OrderParser.Parse(ms);
        }
        catch (Exception ex)
        {
            parseResult = new OrderParseResult();
            parseResult.FileErrors.Add($"Не удалось обработать файл: {ex.Message}");
        }
        finally
        {
            isParsing = false;
        }
    }

    private async Task DownloadTemplateAsync()
    {
        isGenerating = true;
        try
        {
            await DownloadBytesAsync("Шаблон_заказ_кодов.xlsx", OrderTemplate.GenerateTemplate());
            await JS.InvokeVoidAsync("trackEvent", "template_download");
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task OnOrderXsdSelected(InputFileChangeEventArgs e)
    {
        orderXsdBytes = await ReadBytesAsync(e.File);
        orderXsdName = e.File.Name;
        validationResult = null;
    }

    private async Task OnOrderIncludeSelected(InputFileChangeEventArgs e)
    {
        orderIncludeBytes = await ReadBytesAsync(e.File);
        orderIncludeName = e.File.Name;
        validationResult = null;
    }

    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxXsdSize).CopyToAsync(ms);
        return ms.ToArray();
    }

    /// <summary>
    /// Формируем заказ только если приложена официальная XSD и XML по ней прошёл проверку.
    /// </summary>
    private async Task GenerateAndDownloadAsync()
    {
        if (parseResult is null || string.IsNullOrWhiteSpace(contactPerson) || orderXsdBytes is null) return;
        var validRows = parseResult.Rows.Where(r => r.IsValid).ToList();
        if (validRows.Count == 0 || validRows.Count > MaxOrderPositions) return;

        isGeneratingXml = true;
        validationResult = null;
        try
        {
            var p = new OrderXmlService.OrderParams(
                contactPerson.Trim(), releaseMethodCode, createMethodCode, serialNumberTypeCode);
            var xml = OrderXml.Build(validRows, p);

            await Task.Yield(); // дать UI показать спиннер перед синхронной проверкой
            validationResult = XsdValidation.Validate(xml, orderXsdBytes, orderIncludeBytes);

            if (validationResult.IsValid)
            {
                await DownloadBytesAsync("zakaz_kodov.xml", xml);
                xmlDownloaded = true;
                await JS.InvokeVoidAsync("trackEvent", "xml_order");
            }
        }
        finally
        {
            isGeneratingXml = false;
        }
    }

    private async Task DownloadBytesAsync(string fileName, byte[] bytes)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
